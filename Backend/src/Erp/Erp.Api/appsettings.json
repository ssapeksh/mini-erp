{
  "ConnectionStrings": {
    "ErpDb": ""
  },
  "Jwt": {
    "Issuer": "MiniErp",
    "Audience": "MiniErp.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Session": {
    "IdleTimeoutMinutes": 20,
    "ActivityWriteIntervalSeconds": 60,
    "CleanupIntervalSeconds": 60
  },
  "Pricing": {
    "BulkQtyThreshold": 15,
    "BulkDiscountPercent": 5,
    "FestivalStart": "2026-10-15",
    "FestivalEnd": "2026-11-10",
    "FestivalDiscountPercent": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "LoginPermitPerMinute": 5,
    "GlobalPermitPer10Seconds": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
